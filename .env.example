# Copy this file to `.env` and fill it in. `.env` is git-ignored: never commit it.

# Which LLM backs the chatbot: "anthropic" or "gemini". Both implement the same
# LLMProvider interface (src/adoptamatch_chatbot/llm/base.py); the rest of the
# app does not know which one it is talking to.
#
# Anthropic is only a *suggestion* in the assignment brief, made because new
# accounts get $5 of free credit -- it is not free once that runs out. Gemini's
# API has a genuine free tier (no card, no expiring credit) and supports tool
# calling, so it is the option to use if you have no Anthropic balance. OpenAI's
# API is not offered here because it has no free tier at all.
LLM_PROVIDER=anthropic

# --- Anthropic (used when LLM_PROVIDER=anthropic) ---------------------------
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Gemini (used when LLM_PROVIDER=gemini) ----------------------------------
# Get a free key (no billing setup required) at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# "gemini-flash-latest" always points at Google's current free-tier Flash model;
# pin an exact version (e.g. gemini-2.5-flash) if you need a stable target.
GEMINI_MODEL=gemini-flash-latest

# MCP server inventory (copy config/servers.example.toml first).
MCP_SERVERS_CONFIG=config/servers.toml

# Where the JSONL interaction logs are written.
LOG_DIR=logs

# Python logging level for the host itself: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Maximum tool rounds inside a single user turn, before the host stops the loop.
MAX_TOOL_ITERATIONS=8
