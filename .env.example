# Copy this file to `.env` and fill it in. `.env` is git-ignored: never commit it.

# Required unless you run with --offline. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model id. Keep it here, never hard-coded in the source.
ANTHROPIC_MODEL=claude-opus-5

# MCP server inventory (copy config/servers.example.toml first).
MCP_SERVERS_CONFIG=config/servers.toml

# Where the JSONL interaction logs are written.
LOG_DIR=logs

# Python logging level for the host itself: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Maximum tool rounds inside a single user turn, before the host stops the loop.
MAX_TOOL_ITERATIONS=8
